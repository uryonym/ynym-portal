# ==============================================================================
# ynym-portal Docker Compose 環境変数テンプレート
# このファイルをコピーしてルート直下に .env を作成してください:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# バックエンド (FastAPI) 設定
# ------------------------------------------------------------------------------
# データベース接続
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ynym_portal
DB_USER=admin
DB_PASSWORD=your_secure_password_here

# JWT 認証
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Google OAuth2 認証
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# URL 設定
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# CORS 設定 (カンマ区切りで複数指定可能)
ALLOWED_ORIGINS=http://localhost:3000

# アプリケーション環境
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# ------------------------------------------------------------------------------
# フロントエンド (Vite SPA) 設定
# ※ VITE_* は Vite の仕様上 Docker ビルド時に JS バンドルへ埋め込まれます。
#    同一オリジン運用（推奨）の場合、VITE_API_BASE_URL は空文字（未設定）で問題ありません。
#    変更した場合は `docker compose build --no-cache ynym-portal-frontend` を実行してください。
# ------------------------------------------------------------------------------
# VITE_API_BASE_URL=
VITE_SITE_URL=http://localhost:3000
PORT=3000

# ------------------------------------------------------------------------------
# nginx-proxy 連携 (外部プロキシ利用時にアンコメントして設定)
# ------------------------------------------------------------------------------
# BACKEND_VIRTUAL_HOST=api.example.com
# BACKEND_LETSENCRYPT_HOST=api.example.com
# FRONTEND_VIRTUAL_HOST=portal.example.com
# FRONTEND_LETSENCRYPT_HOST=portal.example.com
