# 環境変数テンプレート
# このファイルを .env にコピーして値を更新してください

# データベース
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
# コネクションプール設定 (未設定時は production/staging で自動有効化、SQLAlchemy デフォルト準拠)
# DB_POOL_ENABLED=true
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_TIMEOUT=30
# DB_POOL_RECYCLE=-1
# DB_POOL_PRE_PING=false

# JWT
JWT_SECRET_KEY=
JWT_ALGORITHM=
JWT_EXPIRE_MINUTES=

# Google認証
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL設定
FRONTEND_URL=
BACKEND_URL=

# CORS設定 (カンマ区切りで複数指定可能)
ALLOWED_ORIGINS=

# 環境
ENVIRONMENT=
LOG_LEVEL=
